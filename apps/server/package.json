{
  "name": "@polyroutine/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./dist/app.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "start:worker": "node --env-file-if-exists=../../.env dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1113.0",
    "@polyroutine/contracts": "workspace:*",
    "@polyroutine/db": "workspace:*",
    "fastify": "5.12.1",
    "pg-boss": "12.27.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@polyroutine/testing": "workspace:*",
    "@types/node": "catalog:",
    "fast-check": "4.9.0",
    "typescript": "catalog:",
    "undici": "8.10.0",
    "vitest": "catalog:"
  }
}
