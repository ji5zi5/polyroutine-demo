{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/.omo",
      "!!**/.next",
      "!!**/coverage",
      "!!**/dist",
      "!!**/node_modules",
      "!!**/test-results",
      "!!apps/web/next-env.d.ts",
      "!!proposal_5pages.html",
      "!!proposal_landscape_5pages.html",
      "!!scripts/validate-decisions.mjs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "noDefaultExport": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "useImportType": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/web/app/**/*.tsx",
        "apps/web/app/manifest.ts",
        "apps/web/next.config.mjs",
        "apps/web/playwright.config.ts",
        "apps/web/tests/e2e/support/global-setup.ts",
        "vitest.config.ts",
        "vitest.integration.config.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}
